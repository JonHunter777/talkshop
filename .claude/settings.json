{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run format:check)",
      "Bash(npm run start:dev)",
      "Bash(npm run dev)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat package.json)",
      "Bash(curl http://localhost:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx:*)",
      "Bash(npm run seed)",
      "Bash(npm run evals:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "WebFetch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Bash(cat .env*)",
      "Bash(cat backend/.env)",
      "Bash(cat frontend/.env)",
      "Bash(type backend\\.env)",
      "Bash(type frontend\\.env)",
      "Bash(Get-Content backend/.env)",
      "Bash(Get-Content frontend/.env)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(vercel:*)",
      "Bash(railway:*)",
      "Bash(render:*)",
      "Bash(npm publish:*)",
      "Bash(taskkill /IM:*)",
      "Bash(taskkill //IM:*)",
      "Bash(taskkill /F /IM:*)",
      "Bash(taskkill //F //IM:*)",
      "Bash(taskkill /f /im:*)",
      "Bash(taskkill //f //im:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ]
  }
}
