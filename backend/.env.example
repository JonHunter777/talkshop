# Copy to .env and fill in real values. Never commit .env.

# HTTP port (default 3000)
PORT=3000

# development | production | test
NODE_ENV=development

# MongoDB Atlas connection string (required). Use separate databases for dev and prod.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/talkshop-dev?retryWrites=true&w=majority

# Allowed frontend origins for CORS, comma-separated (default http://localhost:5173).
# No "*", no paths, no empty items. In production only https is allowed (except localhost).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Secret for signing JWT (required, min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-random-secret-min-32-chars>

# JWT lifetime in seconds (60..604800, default 3600 = 1 hour)
JWT_EXPIRES_IN_SECONDS=3600

# --- Seed (npm run seed) ---
# The seed works ONLY on the dev database "talkshop-dev" (MONGODB_URI above).
# It refuses to run when NODE_ENV=production or when the database name is anything else.
# Do not run two seed processes at the same time.
# Demo accounts are created only if they do not exist yet. Changing a password here
# after the first run changes nothing: an existing user is never overwritten.
# Passwords: 8..72 bytes (bcrypt limit). Emails must be different.
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<admin-password>
SEED_USER_EMAIL=<demo-customer-email>
SEED_USER_PASSWORD=<demo-customer-password>
