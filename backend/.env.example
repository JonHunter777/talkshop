# Copy to .env and fill in real values. Never commit .env.

# HTTP port (default 3000)
PORT=3000

# development | production | test
NODE_ENV=development

# MongoDB Atlas connection string (required). Use separate databases for dev and prod.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/talkshop-dev?retryWrites=true&w=majority

# Allowed frontend origin for CORS (default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Secret for signing JWT (required, min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-random-secret-min-32-chars>

# JWT lifetime in seconds (60..604800, default 3600 = 1 hour)
JWT_EXPIRES_IN_SECONDS=3600
