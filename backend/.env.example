# Copy to .env and fill in real values. Never commit .env.

# HTTP port (default 3000)
PORT=3000

# development | production | test
NODE_ENV=development

# MongoDB Atlas connection string (required). Use separate databases for dev and prod.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-shop-dev?retryWrites=true&w=majority

# Allowed frontend origin for CORS (default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
